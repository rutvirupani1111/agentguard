{
  "name": "agentguard",
  "version": "0.1.0",
  "description": "Prompt-injection firewall for AI agents: find hidden instructions in web pages, emails and documents before your LLM reads them.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "agentguard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "prompt-injection",
    "llm",
    "ai-agents",
    "security",
    "firewall",
    "sanitize",
    "hidden-text",
    "unicode",
    "ascii-smuggling",
    "exfiltration",
    "guardrails"
  ],
  "author": "Rutvi Rupani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rutvirupani1111/agentguard.git"
  },
  "homepage": "https://github.com/rutvirupani1111/agentguard#readme",
  "bugs": {
    "url": "https://github.com/rutvirupani1111/agentguard/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
